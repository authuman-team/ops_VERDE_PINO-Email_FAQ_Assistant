    {
      "parameters": {
        "operation": "reply",
        "messageId": "={{ $('Gmail Trigger').item.json.id }}",
        "message": "={{ \n(() => {\n  const hora = new Date().getHours();\n  const saudacao = hora < 12 ? 'Bom dia' : 'Boa tarde';\n\n  let nome =\n    $json['Nome do Cliente'] ||\n    $json.Nome ||\n    $json.nome_cliente ||\n    null;\n\n  if (nome && String(nome).toLowerCase().includes('unknown')) nome = null;\n  if (nome === 'null' || nome === 'undefined') nome = null;\n\n  if (nome) nome = String(nome).trim();\n\n  const normalizar = (str) =>\n    String(str).normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\").toLowerCase();\n\n  const nomesFemininos = [\n    'ana','maria','joana','sofia','beatriz','carla','patricia',\n    'rita','ines','catarina','filipa','claudia','mariana','sara','teresa'\n  ];\n\n  let tratamento = '';\n\n  if (nome) {\n    const primeiroNome = normalizar(nome.split(' ')[0]);\n    tratamento = nomesFemininos.includes(primeiroNome)\n      ? `, cara ${nome}`\n      : `, caro ${nome}`;\n  }\n\n  const resposta = $json.output?.resposta || '';\n\n  return `${saudacao}${tratamento},<br><br>\n${resposta\n  .replace(/^(olá|ola|bom dia|boa tarde)[^<]*<br>/i, '')\n  .replace(/^(olá|ola|bom dia|boa tarde)[^\\n]*\\n/i, '')\n  .replace(/\\n/g, '<br>')}<br><br>\nFicamos ao dispor para qualquer esclarecimento adicional.<br><br>\nEquipa Verde Pino`;\n})()\n}}",
        "options": {
          "appendAttribution": false
        }
      },
